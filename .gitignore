# DeliverAI — Git Ignore Configuration

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Databases & SQLite
*.db
*.sqlite
*.sqlite3
backend/delivery.db

# Heavy Raw Datasets & Large Processed Datasets
backend/data/raw/*
!backend/data/raw/.gitkeep
!backend/data/raw/railway_network/
!backend/data/raw/railway_network/**
backend/data/processed/*
!backend/data/processed/.gitkeep
past_predictions_and_history.csv


# Machine Learning Models & Metrics (whitelisted for Docker / HF deployment)
!backend/models/saved/*.pkl
!backend/models/saved/*.json
!backend/models/saved/.gitkeep


# IDEs, Editors & OS Files
.vscode/
.idea/
.agents/
.gemini/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Test Output Dumps, Temporary Screenshots & Scratch Files
test.txt
range_performance_25km.csv
image.png
*.png
!frontend/assets/*
scratch/

# Logs & Temporary Files
*.log
*.tmp
temp/
tmp/
.tempmediaStorage/
catboost_info/
**/catboost_info/
report_template.html
a.txt
