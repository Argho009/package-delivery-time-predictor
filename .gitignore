# ==============================================================================
# DeliverAI: Package Delivery Time Predictor — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 4. Databases & SQLite
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/delivery.db

# ------------------------------------------------------------------------------
# 5. Heavy Datasets & Raw Historical Data (Exempt small metadata & railway geojson)
# ------------------------------------------------------------------------------
backend/data/raw/*
!backend/data/raw/.gitkeep
!backend/data/raw/railway_network/
!backend/data/raw/railway_network/**
backend/data/processed/*
!backend/data/processed/.gitkeep
past_predictions_and_history.csv
extra/range_performance_25km.csv

# ------------------------------------------------------------------------------
# 6. Machine Learning Weights & Large Model Dumps (>100MB / Git LFS candidates)
# ------------------------------------------------------------------------------
*.gguf
*.safetensors
*.bin
*.ckpt
*.pt
*.pth
*.h5
extra/models/
extra/llama.cpp/

# Preserve lightweight champion scikit-learn models & configs for deployment
!backend/models/saved/*.pkl
!backend/models/saved/*.json
!backend/models/saved/.gitkeep

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks & Data Science Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 8. Web & Frontend Dependencies
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.cache/

# ------------------------------------------------------------------------------
# 9. LaTeX & Typst Auxiliary Files (Keep .tex, .typ, .bib, and compiled PDFs)
# ------------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.lof
*.lot
*.out
*.log
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.glo
*.ist
typst_temp/

# ------------------------------------------------------------------------------
# 10. IDEs, Editors & OS Artifacts
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
.agents/
.gemini/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 11. Logs, Test Dumps & Temporary Scratch Files
# ------------------------------------------------------------------------------
*.tmp
temp/
tmp/
.tempmediaStorage/
catboost_info/
**/catboost_info/
crash_dump.log
test.txt
a.txt
report_template.html
scratch/
