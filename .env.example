# ─────────────────────────────────────────────────────────────────
# DeliverAI: Package Delivery Time Predictor — Environment Template
# Copy this file to .env and configure with your credentials:
#     copy .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Database Configuration ───────────────────────────────────────
# Options: "sqlite" (zero setup, default) or "mysql"
DB_TYPE=sqlite

# If DB_TYPE=mysql:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=delivery_db

# ── Weather API (OpenWeather) ────────────────────────────────────
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Kaggle API (Optional: only needed to re-download raw datasets)
# Generate from: https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Server Settings ──────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=deliverai-development-secret-key
FLASK_PORT=5000
