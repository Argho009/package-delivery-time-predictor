# ─────────────────────────────────────────────────────────────────
# AI Delivery Prediction System — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────────

# ── Kaggle API (for dataset download) ────────────────────────────
# Get from: https://www.kaggle.com/settings → API → Create New Token
# Also place kaggle.json at: ~/.kaggle/kaggle.json
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Weather API (OpenWeather) ────────────────────────────────────
# Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# ── MySQL Database ────────────────────────────────────────────────
# Create the DB first: CREATE DATABASE delivery_db;
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=delivery_db

# Alternatively, set a full SQLAlchemy URL (overrides above if set)
# DATABASE_URL=mysql+pymysql://root:password@localhost/delivery_db

# ── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_PORT=5000
